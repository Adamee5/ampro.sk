{
  "version": "1.0.0",
  "name": "ampro-sk",
  "description": "Web AMpro SK, s.r.o. – projekcia rodinných domov a energetika budov (Astro, Cloudflare Pages).",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "dependencies": {
    "@fancyapps/ui": "^6.1.15",
    "heroicons": "^2.2.0",
    "marked": "^18.3.0",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^4.1.0"
  },
  "keywords": [],
  "author": "LukĂˇĹˇ ChylĂ­k",
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^26",
    "astro": "^7.4.13",
    "decap-server": "^3.11.6",
    "npm-run-all": "^4.1.5",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "smartcrop-sharp": "2.0.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "scripts": {
    "dev": "run-p css:dev astro:dev",
    "start": "bun run dev",
    "build": "bun run css:build && bun run typecheck && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "astro:dev": "astro dev",
    "css:dev": "tailwindcss -i public/styles/tailwind.source.css -o public/styles/tailwind.css --watch",
    "css:build": "tailwindcss -i public/styles/tailwind.source.css -o public/styles/tailwind.css --minify",
    "icons": "bun scripts/generate-icons.ts",
    "cms:local": "decap-server",
    "image-set": "bun scripts/image-set.ts",
    "typecheck": "astro check && node node_modules/typescript-7/bin/tsc --noEmit",
    "creative:check": "bun scripts/creative-check.ts",
    "verify": "bun run build && bun run creative:check",
    "audit": "bun scripts/audit.ts",
    "placeholders": "bun scripts/placeholders.ts"
  },
  "engines": {
    "node": ">=26.0.0",
    "bun": ">=1.4.5"
  },
  "packageManager": "bun@1.4.5"
}
