---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import InquiryForm from "@/components/InquiryForm.astro";
import Legend from "@/components/creative/Legend.astro";
import Kota from "@/components/creative/Kota.astro";
import DrawIcon from "@/components/creative/DrawIcon.astro";
import { site } from "@/data/site";

const page = site.b2b;
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  keywords={page.seo.keywords}
  pathname="/pre-firmy/"
  breadcrumbs={[
    { name: "Úvod", href: "/" },
    { name: "Pre firmy", href: "/pre-firmy/" },
  ]}
>
  <SiteHeader pathname={Astro.url.pathname} />
  <main id="main" class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
    <SectionIntro level={1} icon="am-narez" eyebrow={page.eyebrow} title={page.title} text={page.text} />

    <!-- Services as the drawing set's legend: what each sheet type is. -->
    <Legend caption="Typy výkresov" headingLevel={2} items={page.services} />

    <div class="pricing">
      <DrawIcon name="document-text" class="h-6 w-6 shrink-0 text-primary" />
      <p>{page.pricingText}</p>
    </div>
    <Kota value="cena na dopyt" note="do 24 h" tone="line" class="mt-6 max-w-md" />

    <div class="mx-auto mt-14 max-w-3xl sm:mt-20">
      <InquiryForm
        title={page.formTitle}
        help="Popíšte zákazku, termín a formát výstupu. Priložte výkresy alebo model (DWG, DXF, IFC, PDF, ZIP – spolu do 25 MB)."
        topic="Výkresy pre výrobu / BIM (firmy)"
        fixedTopic
        back="/pre-firmy/"
        submitLabel="Odoslať dopyt"
        messagePlaceholder="Firma, typ zákazky (kladačské výkresy, CNC, nárezové plány, model), rozsah, termín, požadovaný formát…"
      />
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .pricing {
    display: flex;
    gap: 0.75rem;
    max-width: 48rem;
    margin-top: 2rem;
    padding: 1.25rem;
    border: 1.5px solid var(--color-line);
    background: var(--color-surface-elevated);
    line-height: 1.7;
    color: var(--color-muted);
  }

  .pricing p {
    margin: 0;
  }
</style>
