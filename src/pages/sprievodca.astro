---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import Icon from "@/components/ui/Icon.astro";
import { site } from "@/data/site";
import { withBase } from "@/lib/navigation";

const page = site.guide;
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  keywords={page.seo.keywords}
  pathname="/sprievodca/"
  breadcrumbs={[
    { name: "Úvod", href: "/" },
    { name: "Sprievodca", href: "/sprievodca/" },
  ]}
>
  <SiteHeader pathname={Astro.url.pathname} />
  <main id="main" class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
    <SectionIntro level={1} eyebrow="Sprievodca" title={page.title} text={page.text} />

    <form class="guide mt-10 grid gap-5 sm:mt-12" data-guide aria-label="Otázky sprievodcu">
      {page.questions.map((question, index) => (
        <fieldset class="guide__question" data-reveal="fade">
          <legend class="guide__legend">
            <span class="guide__number">{index + 1}/{page.questions.length}</span>
            {question.question}
          </legend>
          <div class="guide__options">
            {question.options.map((option) => (
              <label class="guide__option">
                <input type="radio" name={question.id} value={option.id} required={index === 0} />
                <span>{option.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))}

      <section class="guide__result" aria-live="polite" aria-labelledby="guide-result-title" data-result>
        <p class="text-sm font-medium uppercase tracking-eyebrow text-energy">Odporúčanie</p>
        <h2 id="guide-result-title" class="mt-2 text-2xl text-foreground sm:text-3xl" data-result-title>Odpovedzte na otázky vyššie</h2>
        <p class="mt-3 leading-7 text-muted" data-result-text>Odporúčanie sa zobrazí hneď, ako vyberiete aspoň prvú odpoveď.</p>
        <ol class="guide__steps" data-result-steps></ol>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row" data-result-actions>
          <a class="guide__primary" href={withBase("/konfigurator/")} data-result-link>
            <span data-result-link-label>Pozrieť orientačnú cenu</span>
            <Icon name="arrow-right" variant="mini" class="h-5 w-5" />
          </a>
          <a class="guide__secondary" href={withBase("/kontakt/#dopyt")}>Radšej sa mi ozvite</a>
        </div>
        <noscript>
          <p class="mt-4 leading-7 text-muted">
            Odporúčanie potrebuje JavaScript. Pozrite si rovno <a class="text-primary underline" href={withBase("/konfigurator/")}>konfigurátor ceny</a> alebo nám <a class="text-primary underline" href={withBase("/kontakt/#dopyt")}>napíšte</a>.
          </p>
        </noscript>
      </section>
    </form>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .guide__question {
    margin: 0;
    padding: calc(var(--spacing) * 6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    min-inline-size: 0;
  }

  .guide__legend {
    float: left;
    width: 100%;
    margin-bottom: calc(var(--spacing) * 4);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-foreground);
  }

  .guide__legend + * {
    clear: both;
  }

  .guide__number {
    display: block;
    margin-bottom: calc(var(--spacing) * 1);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-primary);
  }

  .guide__options {
    display: grid;
    gap: calc(var(--spacing) * 2);
  }

  @media (min-width: 640px) {
    .guide__options {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .guide__option {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 3);
    min-height: 3rem;
    padding: calc(var(--spacing) * 3) calc(var(--spacing) * 4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-background);
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-standard);
  }

  .guide__option:hover {
    border-color: var(--color-primary);
  }

  .guide__option:has(:checked) {
    border-color: var(--color-primary);
    box-shadow: inset 0 0 0 1px var(--color-primary);
    background: color-mix(in oklch, var(--color-primary-soft) 55%, var(--color-background));
  }

  .guide__option:has(:focus-visible) {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .guide__option input {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    accent-color: var(--color-primary);
  }

  .guide__option input:focus-visible {
    outline: none;
  }

  .guide__result {
    margin-top: calc(var(--spacing) * 4);
    padding: calc(var(--spacing) * 8);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-2xl);
    background: var(--color-surface-elevated);
    box-shadow:
      inset 0 3px 0 var(--color-energy),
      var(--shadow-soft);
  }

  .guide__steps {
    display: grid;
    gap: calc(var(--spacing) * 3);
    margin: calc(var(--spacing) * 5) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .guide__steps :global(li) {
    position: relative;
    padding-left: calc(var(--spacing) * 10);
    line-height: 1.6;
    color: var(--color-foreground);
    counter-increment: step;
  }

  .guide__steps :global(li::before) {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1.5px solid var(--color-energy);
    border-radius: 50%;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-energy);
  }

  [data-result-actions]:not([data-shown]) {
    display: none;
  }

  .guide__primary,
  .guide__secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: calc(var(--spacing) * 2);
    min-height: 3rem;
    padding: calc(var(--spacing) * 3) calc(var(--spacing) * 6);
    border-radius: var(--radius-md);
    font-weight: 600;
    text-decoration: none;
  }

  .guide__primary {
    background: var(--color-action);
    color: var(--color-on-action);
    box-shadow: var(--shadow-card);
  }

  .guide__primary:hover {
    background: var(--color-action-hover);
  }

  .guide__secondary {
    border: 1px solid var(--color-border-strong);
    color: var(--color-foreground);
  }

  .guide__secondary:hover {
    border-color: var(--color-foreground);
  }
</style>

<script>
  // Turns the answers into a short plan and a prefilled configurator link
  // (/konfigurator/?typ=…&velkost=…&stupne=…&doplnky=…&priplatky=…).
  const form = document.querySelector<HTMLFormElement>("[data-guide]");
  const title = document.querySelector<HTMLElement>("[data-result-title]");
  const text = document.querySelector<HTMLElement>("[data-result-text]");
  const steps = document.querySelector<HTMLOListElement>("[data-result-steps]");
  const actions = document.querySelector<HTMLElement>("[data-result-actions]");
  const link = document.querySelector<HTMLAnchorElement>("[data-result-link]");
  const linkLabel = document.querySelector<HTMLElement>("[data-result-link-label]");
  const base = import.meta.env.BASE_URL.replace(/\/$/, "");

  const answer = (name: string) => form?.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? "";

  const render = () => {
    if (!form || !title || !text || !steps || !actions || !link || !linkLabel) return;
    const plan = answer("plan");
    if (!plan) return;
    const land = answer("pozemok");
    const docs = answer("podklady");
    const size = answer("velkost");
    const priority = answer("priorita");

    const list: string[] = [];
    let href = `${base}/konfigurator/`;
    let label = "Pozrieť orientačnú cenu";

    if (plan === "cert") {
      title.textContent = "Stačí vám energetický certifikát";
      text.textContent = "Vypočítajte si cenu certifikátu a rovno nahrajte podklady – presné nacenenie pošleme do 24 hodín.";
      list.push("Vyberte účel certifikátu (kolaudácia, predaj, Obnov dom).", "Nahrajte projekt alebo fotky domu.", "Dohodneme obhliadku a certifikát vystavíme.");
      href = `${base}/energeticky-certifikat/`;
      label = "Vypočítať cenu certifikátu";
    } else if (plan === "rekon") {
      title.textContent = "Rekonštrukcia: začneme stavom domu";
      text.textContent = "Pri prestavbe závisí rozsah od toho, čo z domu zostáva. Pošlite fotky alebo starý projekt a navrhneme postup.";
      list.push("Zameranie existujúceho stavu a energetické posúdenie.", "Štúdia úprav v BIM modeli – dispozícia, zateplenie, technika.", "Projekt pre úrad a prípadne podklady pre dotáciu Obnov dom.");
      href = `${base}/konfigurator/?typ=rekonstrukcia`;
    } else {
      const stages = new Set<string>();
      const extras = new Set<string>(["elektro", "zti", "uk", "bleskozvod", "peh"]);
      const surcharges = new Set<string>();

      if (land === "nie" || land === "kupujem") {
        list.push("Pred kúpou overíme pozemok – regulatívy obce, prístup, siete, svah. Ušetrí to drahé prekvapenia.");
      }
      if (docs === "projekt") {
        list.push("Prejdeme váš projekt a doplníme chýbajúce profesie a energetiku (PEH), aby dom splnil A0.");
        stages.add("projekt");
      } else if (docs === "katalog") {
        list.push("Katalógový projekt prispôsobíme pozemku a vašim požiadavkám a prepočítame jeho energetiku.");
        stages.add("zamer").add("projekt");
      } else {
        list.push("Začneme návrhom v BIM modeli – dispozícia a vzhľad domu ešte pred papierovačkami.");
        stages.add("studia").add("zamer").add("projekt");
      }
      list.push("Stavebný zámer a projekt stavby so všetkými profesiami a prípojkami podľa zákona 25/2025.");

      if (priority === "energia") {
        list.push("Energetiku nastavíme na čo najnižšie náklady – tepelné čerpadlo, rekuperácia, prípadne fotovoltika.");
        extras.add("vzt").add("ecb");
      } else if (priority === "rychlost") {
        list.push("Vybavíme aj vyjadrenia a povolenie (inžiniering), aby ste nemuseli behať po úradoch.");
        extras.add("inziniering");
      } else if (priority === "dizajn") {
        list.push("Pripravíme vizualizácie, aby ste dom videli skôr, než ho postavíte.");
        extras.add("vizualizacie");
        stages.add("studia");
      } else if (priority === "rozpocet") {
        list.push("Rozsah projektu udržíme na tom, čo úrad naozaj vyžaduje – nič navyše.");
      }
      list.push("Po dokončení stavby vystavíme energetický certifikát ku kolaudácii.");

      if (size === "poschodie") surcharges.add("podlazie");
      title.textContent = docs === "projekt" ? "Doplníme, čo vášmu projektu chýba" : "Váš postup k domu triedy A0";
      text.textContent = "Takto by sme postupovali. Pripravili sme aj konfigurátor s predvyplneným výberom – ceny si môžete upraviť.";
      const params = new URLSearchParams({
        typ: "rd",
        velkost: size === "large" ? "large" : "small",
        stupne: [...stages].join(","),
        doplnky: [...extras].join(","),
        priplatky: [...surcharges].join(","),
      });
      href = `${base}/konfigurator/?${params.toString()}`;
    }

    steps.replaceChildren(
      ...list.map((item) => {
        const li = document.createElement("li");
        li.textContent = item;
        return li;
      }),
    );
    link.href = href;
    linkLabel.textContent = label;
    actions.dataset.shown = "";
  };

  form?.addEventListener("change", render);
  render();
</script>
