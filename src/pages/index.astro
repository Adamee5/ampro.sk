---
import Icon from "@/components/ui/Icon.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import HeroSection from "@/components/HeroSection.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import FaqSection from "@/components/FaqSection.astro";
import AxesDiagram from "@/components/AxesDiagram.astro";
import CutLine from "@/components/creative/CutLine.astro";
import DrawIcon from "@/components/creative/DrawIcon.astro";
import Button from "@/components/ui/Button.astro";
import { site } from "@/data/site";
import { faqPage } from "@/lib/structured-data";
import { withBase } from "@/lib/navigation";

const { seo, hero, doors, axes, process, trust, reviews, faq, cta } = site.home;
type Tone = "design" | "energy";
const tone = (value: string): Tone => (value === "energy" ? "energy" : "design");
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  pathname="/"
  imageAlt={hero.imageAlt}
  schema={faq.length ? [faqPage()] : []}
>
  <SiteHeader pathname={Astro.url.pathname} />
  <main id="main">
    <HeroSection />

    <!-- 01 Two doors, drawn as detail callouts (bubble + leader). -->
    <section id="obsah" class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8 lg:py-24" aria-labelledby="doors-title">
      <SectionIntro icon="map" eyebrow={doors.eyebrow} title={doors.title} headingId="doors-title" />
      <ul class="mt-10 grid list-none gap-6 sm:mt-14 md:grid-cols-2 md:gap-8">
        {
          doors.items.map((door, index) => (
            <li data-reveal style={`--reveal-i: ${index}`}>
              <a href={withBase(door.href)} class:list={["door group", `door--${tone(door.tone)}`]}>
                <span class="door__detail" aria-hidden="true"><DrawIcon name={door.icon ?? "am-dom"} class="h-6 w-6" /></span>
                <span class="door__label">{door.label}</span>
                <span class="mt-4 block text-2xl font-semibold text-foreground sm:text-3xl">{door.title}</span>
                <span class="mt-3 block leading-7 text-muted">{door.text}</span>
                <span class="door__cta">
                  {door.cta}
                  <Icon name="arrow-right" class="h-5 w-5 transition-transform duration-fast group-hover:translate-x-1" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="mt-6 flex list-none flex-col gap-x-8 gap-y-1 sm:flex-row">
        {
          doors.links.map((link) => (
            <li>
              <a href={withBase(link.href)} class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-muted underline decoration-border-strong underline-offset-4 hover:text-foreground hover:decoration-primary">
                {link.label}
                <Icon name="arrow-right" variant="mini" class="h-4 w-4" />
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <CutLine icon="am-bim" />

    <!-- 02 The two axes of the business card. -->
    <section class="py-14 sm:py-20 lg:py-24" aria-labelledby="axes-title">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <SectionIntro icon="am-kota" eyebrow={axes.eyebrow} title={axes.title} text={axes.text} headingId="axes-title" />
        <div class="mt-10 grid items-center gap-8 lg:mt-14 lg:grid-cols-[1fr_auto_1fr] lg:gap-10">
          <div class="axis-card axis-card--design" data-reveal>
            <h3 class="flex items-center gap-3 text-xl text-foreground">
              <span class="axis-card__dot" aria-hidden="true"></span>{axes.design.title}
            </h3>
            <ul class="mt-4 grid list-none gap-3">
              {axes.design.items.map((item) => (
                <li class="flex gap-3 leading-7 text-muted"><Icon name="check" variant="mini" class="mt-1 h-5 w-5 shrink-0 text-primary" />{item}</li>
              ))}
            </ul>
          </div>
          <AxesDiagram caption={axes.intersection} />
          <div class="axis-card axis-card--energy" data-reveal style="--reveal-i: 1">
            <h3 class="flex items-center gap-3 text-xl text-foreground">
              <span class="axis-card__dot" aria-hidden="true"></span>{axes.energy.title}
            </h3>
            <ul class="mt-4 grid list-none gap-3">
              {axes.energy.items.map((item) => (
                <li class="flex gap-3 leading-7 text-muted"><Icon name="check" variant="mini" class="mt-1 h-5 w-5 shrink-0 text-energy" />{item}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <CutLine icon="am-obalka" tone="energy" />

    <!-- 03 The process as one chain dimension (reťazová kóta): each step is a
         measured segment of the same line, its duration written on it. -->
    <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8 lg:py-24" aria-labelledby="process-title">
      <SectionIntro icon="clock" eyebrow={process.eyebrow} title={process.title} headingId="process-title" />
      <ol class="chain mt-12 list-none sm:mt-16">
        {
          process.steps.map((step, index) => (
            <li class:list={["chain__step", index === process.steps.length - 1 && "chain__step--energy"]} data-reveal="fade" style={`--reveal-i: ${index}`}>
              <p class="chain__time tabular"><span>{step.time}</span></p>
              <span class="chain__icon" aria-hidden="true"><DrawIcon name={step.icon ?? "am-kota"} class="h-7 w-7" /></span>
              <h3 class="mt-2 text-lg text-foreground">{step.title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <CutLine icon="am-kota" />

    <!-- 04 Why AMpro as the drawing's legend (symbol – meaning). -->
    <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8 lg:py-24" aria-labelledby="trust-title">
      <SectionIntro icon="shield-check" eyebrow={trust.eyebrow} title={trust.title} headingId="trust-title" />
      <p class="legend__caption" aria-hidden="true">Legenda</p>
      <ul class="legend list-none">
        {
          trust.items.map((item, index) => (
            <li class="legend__row" data-reveal="fade" style={`--reveal-i: ${index}`}>
              <span class:list={["legend__symbol", index === 0 ? "text-energy" : "text-primary"]}>
                <DrawIcon name={item.icon} class="h-6 w-6" />
              </span>
              <h3 class="legend__title">{item.title}</h3>
              <div class="legend__text">
                <p>{item.text}</p>
                {index === 0 && (
                  <a href={site.credentials.registerUrl} target="_blank" rel="noopener" class="mt-1 inline-flex min-h-11 items-center gap-1 text-sm font-medium text-energy hover:underline">
                    Overiť v registri SKSI<span class="sr-only"> (otvorí sa v novom okne)</span>
                    <Icon name="arrow-top-right-on-square" variant="mini" class="h-4 w-4" />
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    {
      reviews.items.length > 0 && (
        <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8 lg:py-24" aria-labelledby="reviews-title">
          <SectionIntro eyebrow={reviews.eyebrow} title={reviews.title} headingId="reviews-title" />
          <ul class="mt-10 grid list-none gap-6 md:grid-cols-3">
            {reviews.items.map((review: { author: string; text: string; rating?: number }, index: number) => (
              <li class="flex h-full flex-col border border-border-strong bg-surface p-6" data-reveal style={`--reveal-i: ${index}`}>
                <p class="text-energy" aria-label={`Hodnotenie ${review.rating ?? 5} z 5`}>{"★".repeat(review.rating ?? 5)}</p>
                <blockquote class="mt-3 flex-1 leading-7 text-foreground">„{review.text}“</blockquote>
                <p class="mt-4 text-sm text-muted">{review.author}</p>
              </li>
            ))}
          </ul>
          {reviews.googleUrl && (
            <p class="mt-8">
              <a href={reviews.googleUrl} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center text-sm font-medium text-primary hover:underline">
                Všetky recenzie na Google<span class="sr-only"> (otvorí sa v novom okne)</span> &rarr;
              </a>
            </p>
          )}
        </section>
      )
    }

    {faq.length > 0 && <FaqSection items={faq} />}

    <section class="cta border-y border-border-strong py-14 text-foreground sm:py-20 lg:py-24" aria-labelledby="cta-title">
      <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 px-4 sm:px-6 lg:flex-row lg:items-center lg:px-8" data-reveal>
        <div class="max-w-3xl space-y-4">
          <p class="text-sm font-medium uppercase tracking-eyebrow text-primary">{cta.eyebrow}</p>
          <h2 id="cta-title" class="text-2xl leading-tight sm:text-3xl md:text-5xl">{cta.title}</h2>
        </div>
        <Button as="a" href={withBase(cta.href)} variant="primary" size="lg" fullWidth rel={undefined} class="lg:w-auto">
          {cta.label}
          <Icon name="arrow-right" class="h-5 w-5" />
        </Button>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  /* Door = a detail on the drawing: sharp ruled frame, a numbered detail
     bubble on the corner, tone line on top. It is a link: lift on hover. */
  .door {
    --tone: var(--color-primary);
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: calc(var(--spacing) * 8) calc(var(--spacing) * 7) calc(var(--spacing) * 7);
    border: 1.5px solid var(--color-line);
    background: var(--color-surface-elevated);
    color: inherit;
    text-decoration: none;
    box-shadow: inset 0 4px 0 var(--tone);
    transition:
      transform var(--duration-standard) var(--ease-settle),
      box-shadow var(--duration-standard) var(--ease-standard);
  }

  .door--energy {
    --tone: var(--color-energy);
  }

  .door:hover,
  .door:focus-visible {
    transform: translate(-4px, -4px);
    box-shadow:
      inset 0 4px 0 var(--tone),
      6px 6px 0 var(--tone);
  }

  @media (min-width: 40rem) {
    .door {
      padding: calc(var(--spacing) * 10) calc(var(--spacing) * 9) calc(var(--spacing) * 9);
    }
  }

  .door__detail {
    position: absolute;
    top: -1.5rem;
    right: 1.5rem;
    display: grid;
    place-items: center;
    width: 3rem;
    aspect-ratio: 1;
    border: 1.5px solid var(--tone);
    border-radius: 50%;
    background: var(--color-background);
    color: var(--tone);
  }

  /* detail bubble is split like on a drawing: number / sheet */
  .door__detail::after {
    content: "";
    position: absolute;
    inset: 50% 0.25rem auto;
    height: 1px;
    background: var(--tone);
    opacity: 0;
  }

  .door__label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--tone);
  }

  .door__cta {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    margin-top: auto;
    padding-top: calc(var(--spacing) * 6);
    font-weight: 600;
    color: var(--color-foreground);
  }

  .axis-card {
    --tone: var(--color-primary);
    padding: calc(var(--spacing) * 7);
    border: 1.5px solid var(--color-line);
    background: var(--color-surface-elevated);
  }

  .axis-card--energy {
    --tone: var(--color-energy);
  }

  .axis-card__dot {
    width: 0.75rem;
    height: 0.75rem;
    border: 2px solid var(--tone);
    border-radius: 50%;
  }

  /* Chain dimension: one continuous line split into segments by 45° ticks,
     the duration written on each segment. Vertical on phones. */
  .chain {
    display: grid;
    gap: 0;
    margin-bottom: 0;
    padding: 0;
  }

  .chain__step {
    --tone: var(--color-primary);
    position: relative;
    padding: 0 0 2.25rem 2rem;
    border-left: 1.5px solid var(--tone);
  }

  .chain__step--energy {
    --tone: var(--color-energy);
  }

  .chain__step::before {
    content: "";
    position: absolute;
    top: -0.5rem;
    left: -0.6rem;
    width: 1.1rem;
    height: 1.5px;
    background: var(--tone);
    rotate: -45deg;
  }

  .chain__time {
    margin: 0 0 0.75rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--tone);
  }

  .chain__icon {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    aspect-ratio: 1;
    border: 1.5px solid var(--tone);
    border-radius: 50%;
    color: var(--tone);
  }

  @media (min-width: 64rem) {
    .chain {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      padding-top: 2.5rem;
    }

    .chain__step {
      padding: 2.25rem 1.5rem 0 0;
      border-left: 0;
      border-top: 1.5px solid var(--tone);
    }

    .chain__step::before {
      top: -0.55rem;
      left: -0.55rem;
      width: 1.5px;
      height: 1.1rem;
      rotate: 45deg;
    }

    /* the closing tick at the very end of the chain */
    .chain__step:last-child::after {
      content: "";
      position: absolute;
      top: -0.55rem;
      right: 0;
      width: 1.5px;
      height: 1.1rem;
      background: var(--tone);
      rotate: 45deg;
    }

    .chain__time {
      position: absolute;
      top: -2.4rem;
      left: 0;
      right: 1.5rem;
      text-align: center;
    }

    .chain__time span {
      padding: 0.1rem 0.5rem;
      background: var(--color-background);
    }
  }

  /* Legend: symbol – term – meaning, ruled like a drawing's legend table. */
  .legend__caption {
    margin: 2.5rem 0 0;
    padding: 0.5rem 0.875rem;
    border: 1.5px solid var(--color-line);
    border-bottom: 0;
    width: max-content;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .legend {
    margin: 0;
    padding: 0;
    border: 1.5px solid var(--color-line);
  }

  .legend__row {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    border-bottom: 1px solid var(--color-border-strong);
  }

  .legend__row:last-child {
    border-bottom: 0;
  }

  .legend__symbol {
    display: grid;
    place-items: center;
    grid-row: span 2;
    border-right: 1px solid var(--color-border-strong);
  }

  .legend__title {
    margin: 0;
    padding: 1rem 1.25rem 0;
    font-size: 1.0625rem;
    color: var(--color-foreground);
  }

  .legend__text {
    padding: 0.25rem 1.25rem 1rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .legend__text p {
    margin: 0;
  }

  @media (min-width: 48rem) {
    .legend__row {
      grid-template-columns: 4.5rem 16rem 1fr;
      align-items: center;
    }

    .legend__symbol {
      grid-row: auto;
      align-self: stretch;
    }

    .legend__title {
      padding: 1.25rem 1.5rem;
      border-right: 1px solid var(--color-border-strong);
      align-self: stretch;
      display: flex;
      align-items: center;
    }

    .legend__text {
      padding: 1rem 1.5rem;
    }
  }

  .cta {
    background:
      repeating-linear-gradient(
        -45deg,
        color-mix(in oklch, var(--color-energy) 10%, transparent) 0 1px,
        transparent 1px 10px
      ),
      var(--color-surface-elevated);
  }
</style>
