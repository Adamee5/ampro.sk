---
import Icon from "@/components/ui/Icon.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import HeroSection from "@/components/HeroSection.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import FaqSection from "@/components/FaqSection.astro";
import AxesDiagram from "@/components/AxesDiagram.astro";
import Button from "@/components/ui/Button.astro";
import { site } from "@/data/site";
import { heroPreload } from "@/lib/images";
import { faqPage } from "@/lib/structured-data";
import { withBase } from "@/lib/navigation";

const { seo, hero, doors, axes, process, trust, reviews, faq, cta } = site.home;
type Tone = "design" | "energy";
const tone = (value: string): Tone => (value === "energy" ? "energy" : "design");
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  pathname="/"
  imageAlt={hero.imageAlt}
  preload={heroPreload()}
  schema={faq.length ? [faqPage()] : []}
>
  <SiteHeader pathname={Astro.url.pathname} />
  <main id="main">
    <HeroSection />

    <!-- Two doors: by where the visitor is, not by our service list. -->
    <section id="obsah" class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8 lg:py-24" aria-labelledby="doors-title">
      <SectionIntro eyebrow={doors.eyebrow} title={doors.title} align="center" headingId="doors-title" />
      <ul class="mt-10 grid list-none gap-6 sm:mt-14 md:grid-cols-2">
        {
          doors.items.map((door, index) => (
            <li data-reveal style={`--reveal-i: ${index}`}>
              <a
                href={withBase(door.href)}
                class:list={["door group", `door--${tone(door.tone)}`]}
              >
                <span class="door__label">{door.label}</span>
                <span class="mt-4 block text-2xl font-semibold text-foreground sm:text-3xl">{door.title}</span>
                <span class="mt-3 block leading-7 text-muted">{door.text}</span>
                <span class="door__cta">
                  {door.cta}
                  <Icon name="arrow-right" class="h-5 w-5 transition-transform duration-fast group-hover:translate-x-1" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="mt-6 flex list-none flex-col items-center justify-center gap-x-8 gap-y-1 sm:flex-row">
        {
          doors.links.map((link) => (
            <li>
              <a href={withBase(link.href)} class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-muted underline decoration-border-strong underline-offset-4 hover:text-foreground hover:decoration-primary">
                {link.label}
                <Icon name="arrow-right" variant="mini" class="h-4 w-4" />
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="border-y border-border bg-surface py-14 sm:py-20 lg:py-24" aria-labelledby="axes-title">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <SectionIntro eyebrow={axes.eyebrow} title={axes.title} text={axes.text} headingId="axes-title" />
        <div class="mt-10 grid items-center gap-8 lg:mt-14 lg:grid-cols-[1fr_auto_1fr] lg:gap-10">
          <div class="axis-card axis-card--design" data-reveal>
            <h3 class="flex items-center gap-3 text-xl text-foreground">
              <span class="axis-card__dot" aria-hidden="true"></span>{axes.design.title}
            </h3>
            <ul class="mt-4 grid list-none gap-3">
              {axes.design.items.map((item) => (
                <li class="flex gap-3 leading-7 text-muted"><Icon name="check" variant="mini" class="mt-1 h-5 w-5 shrink-0 text-primary" />{item}</li>
              ))}
            </ul>
          </div>
          <AxesDiagram caption={axes.intersection} />
          <div class="axis-card axis-card--energy" data-reveal style="--reveal-i: 1">
            <h3 class="flex items-center gap-3 text-xl text-foreground">
              <span class="axis-card__dot" aria-hidden="true"></span>{axes.energy.title}
            </h3>
            <ul class="mt-4 grid list-none gap-3">
              {axes.energy.items.map((item) => (
                <li class="flex gap-3 leading-7 text-muted"><Icon name="check" variant="mini" class="mt-1 h-5 w-5 shrink-0 text-energy" />{item}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8 lg:py-24" aria-labelledby="process-title">
      <SectionIntro eyebrow={process.eyebrow} title={process.title} headingId="process-title" />
      <ol class="process mt-10 grid list-none gap-4 sm:mt-14 md:grid-cols-2 lg:grid-cols-5 lg:gap-5">
        {
          process.steps.map((step, index) => (
            <li class="process__step" data-reveal style={`--reveal-i: ${index}`}>
              <span class="process__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <h3 class="mt-4 text-lg text-foreground">{step.title}</h3>
              <p class="mt-1 text-sm font-medium text-primary">{step.time}</p>
              <p class="mt-3 text-sm leading-6 text-muted">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="border-t border-border bg-surface py-14 sm:py-20 lg:py-24" aria-labelledby="trust-title">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <SectionIntro eyebrow={trust.eyebrow} title={trust.title} align="center" headingId="trust-title" />
        <!-- Not links: no hover effect, so nothing suggests a click. -->
        <ul class="mt-10 grid list-none gap-6 sm:mt-14 sm:grid-cols-2 lg:grid-cols-4">
          {
            trust.items.map((item, index) => (
              <li class="flex h-full flex-col rounded-xl border border-border bg-background p-6" data-reveal style={`--reveal-i: ${index}`}>
                <span class:list={["inline-flex h-11 w-11 items-center justify-center rounded-full", index === 0 ? "bg-energy/10 text-energy" : "bg-primary/10 text-primary"]}>
                  <Icon name={item.icon} class="h-5 w-5" />
                </span>
                <h3 class="mt-5 text-lg text-foreground">{item.title}</h3>
                <p class="mt-2 text-sm leading-6 text-muted">{item.text}</p>
                {index === 0 && (
                  <a href={site.credentials.registerUrl} target="_blank" rel="noopener" class="mt-3 inline-flex min-h-11 items-center gap-1 text-sm font-medium text-energy hover:underline">
                    Overiť v registri SKSI<span class="sr-only"> (otvorí sa v novom okne)</span>
                    <Icon name="arrow-top-right-on-square" variant="mini" class="h-4 w-4" />
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {
      reviews.items.length > 0 && (
        <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8 lg:py-24" aria-labelledby="reviews-title">
          <SectionIntro eyebrow={reviews.eyebrow} title={reviews.title} align="center" headingId="reviews-title" />
          <ul class="mt-10 grid list-none gap-6 md:grid-cols-3">
            {reviews.items.map((review: { author: string; text: string; rating?: number }, index: number) => (
              <li class="flex h-full flex-col rounded-xl border border-border bg-surface p-6" data-reveal style={`--reveal-i: ${index}`}>
                <p class="text-energy" aria-label={`Hodnotenie ${review.rating ?? 5} z 5`}>{"★".repeat(review.rating ?? 5)}</p>
                <blockquote class="mt-3 flex-1 leading-7 text-foreground">„{review.text}“</blockquote>
                <p class="mt-4 text-sm text-muted">{review.author}</p>
              </li>
            ))}
          </ul>
          {reviews.googleUrl && (
            <p class="mt-8 text-center">
              <a href={reviews.googleUrl} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center text-sm font-medium text-primary hover:underline">
                Všetky recenzie na Google<span class="sr-only"> (otvorí sa v novom okne)</span> &rarr;
              </a>
            </p>
          )}
        </section>
      )
    }

    {faq.length > 0 && <FaqSection items={faq} />}

    <section
      class="cta-glow relative isolate overflow-hidden border-y border-border bg-surface-elevated py-14 text-foreground sm:py-20 lg:py-24"
      aria-labelledby="cta-title"
    >
      <div
        class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 px-4 sm:px-6 lg:flex-row lg:items-center lg:px-8"
        data-reveal
      >
        <div class="max-w-3xl space-y-4">
          <p class="text-sm font-medium uppercase tracking-eyebrow text-primary">{cta.eyebrow}</p>
          <h2 id="cta-title" class="text-2xl leading-tight sm:text-3xl md:text-5xl">{cta.title}</h2>
        </div>
        <Button as="a" href={withBase(cta.href)} variant="primary" size="lg" fullWidth rel={undefined} class="lg:w-auto">
          {cta.label}
          <Icon name="arrow-right" class="h-5 w-5" />
        </Button>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  /* Door cards are links: a lift and the tone line on hover/focus. */
  .door {
    --tone: var(--color-primary);
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: calc(var(--spacing) * 7);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    background: var(--color-surface);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    box-shadow: inset 0 3px 0 var(--tone);
    transition:
      transform var(--duration-standard) var(--ease-out-soft),
      box-shadow var(--duration-standard) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .door--energy {
    --tone: var(--color-energy);
  }

  .door::after {
    content: "";
    position: absolute;
    inset: auto -20% -60% auto;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in oklch, var(--tone) 14%, transparent), transparent 70%);
    pointer-events: none;
  }

  .door:hover,
  .door:focus-visible {
    transform: translateY(-3px);
    border-color: color-mix(in oklch, var(--tone) 45%, var(--color-border));
    box-shadow:
      inset 0 3px 0 var(--tone),
      var(--shadow-lifted);
  }

  @media (min-width: 640px) {
    .door {
      padding: calc(var(--spacing) * 9);
    }
  }

  .door__label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--tone);
  }

  .door__cta {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    margin-top: auto;
    padding-top: calc(var(--spacing) * 6);
    font-weight: 600;
    color: var(--color-foreground);
  }

  .axis-card {
    --tone: var(--color-primary);
    padding: calc(var(--spacing) * 7);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-background);
  }

  .axis-card--energy {
    --tone: var(--color-energy);
  }

  .axis-card__dot {
    width: 0.75rem;
    height: 0.75rem;
    border: 2px solid var(--tone);
    border-radius: 50%;
  }

  .process__step {
    position: relative;
    padding: calc(var(--spacing) * 6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
  }

  .process__number {
    font-size: 2rem;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-primary);
  }

  .process__step:last-child .process__number {
    color: var(--color-energy);
  }

  /* Final CTA: soft brand light behind the copy (accent only). */
  .cta-glow::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        ellipse 55% 90% at 0% 100%,
        color-mix(in oklch, var(--color-primary) 12%, transparent),
        transparent 70%
      ),
      radial-gradient(
        ellipse 45% 80% at 100% 0%,
        color-mix(in oklch, var(--color-energy) 12%, transparent),
        transparent 70%
      );
    pointer-events: none;
  }
</style>
