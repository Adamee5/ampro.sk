---
/**
 * Mobile price dock for the price calculators (konfigurátor, certifikát).
 *
 * Below `lg` the summary sits under a long form, so the price would scroll out
 * of sight. This bar slides up from the bottom once the visitor scrolls down
 * or changes/types anything in the calculator, stays while the form is on
 * screen, and steps aside when the real summary (#suhrn) is visible.
 *
 * It mirrors the page's `[data-total]` and its sub-line (`[data-range]` or
 * `[data-total-note]`) – the page script keeps computing the price as before.
 * It follows the on-screen keyboard (visualViewport), so the price stays
 * visible while typing the floor area.
 */
import Icon from "@/components/ui/Icon.astro";

export interface Props {
  label: string;
  /** Accent for the label: projekcia (primary) or energetika (energy). */
  tone?: "primary" | "energy";
}

const { label, tone = "primary" } = Astro.props;
---

<div class="price-dock lg:hidden" data-price-dock data-shown="false">
  <a
    href="#suhrn"
    class="mx-auto flex max-w-3xl items-center gap-3 rounded-2xl border border-border bg-surface-elevated px-4 py-2.5 text-foreground no-underline shadow-lifted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
  >
    <span class="flex min-w-0 flex-1 flex-col">
      <span class:list={["text-[0.7rem] font-semibold uppercase tracking-eyebrow", tone === "energy" ? "text-energy" : "text-primary"]}>
        {label}
      </span>
      <span class="price-dock__price text-xl font-bold leading-tight tabular-nums" data-dock-total>—</span>
      <span class="truncate text-xs text-muted" data-dock-sub></span>
    </span>
    <span class="inline-flex min-h-11 shrink-0 items-center gap-1 rounded-full bg-action px-4 text-sm font-semibold text-on-action">
      Detail
      <Icon name="arrow-down" variant="mini" class="h-4 w-4" />
    </span>
  </a>
</div>

<style>
  /* While the dock is up, keep focused fields clear of it (WCAG 2.4.11). */
  :global(html:has([data-price-dock][data-shown="true"])) {
    scroll-padding-block-end: 7rem;
  }

  .price-dock {
    position: fixed;
    inset-inline: 0;
    bottom: var(--dock-kb, 0px);
    z-index: var(--z-sticky);
    padding: 0.5rem 0.75rem calc(0.5rem + env(safe-area-inset-bottom));
    transform: translateY(110%);
    visibility: hidden;
    transition:
      transform var(--duration-standard) var(--ease-out-soft),
      visibility 0s linear var(--duration-standard);
  }

  .price-dock[data-shown="true"] {
    transform: none;
    visibility: visible;
    transition:
      transform var(--duration-standard) var(--ease-out-soft),
      visibility 0s;
  }

  .price-dock__price[data-bump] {
    animation: dock-bump 360ms var(--ease-out-soft);
  }

  @keyframes dock-bump {
    40% {
      transform: scale(1.06);
    }
  }
</style>

<script>
  const dock = document.querySelector<HTMLElement>("[data-price-dock]");
  const total = document.querySelector<HTMLElement>("[data-total]");
  const sub = document.querySelector<HTMLElement>("[data-range], [data-total-note]");
  const form = document.querySelector<HTMLFormElement>("[data-price-form]");
  const summary = document.querySelector<HTMLElement>("#suhrn");
  const dockTotal = dock?.querySelector<HTMLElement>("[data-dock-total]");
  const dockSub = dock?.querySelector<HTMLElement>("[data-dock-sub]");

  if (dock && total && form && summary && dockTotal && dockSub) {
    let engaged = false;
    let formVisible = false;
    let focusWithin = false;
    let summaryVisible = false;
    let startY = window.scrollY;

    const render = () => {
      dock.dataset.shown = String(engaged && (formVisible || focusWithin) && !summaryVisible);
    };

    // Mirror the price computed by the page script.
    const mirror = () => {
      const next = total.textContent?.trim() || "—";
      if (dockTotal.textContent !== next) {
        dockTotal.textContent = next;
        dockTotal.removeAttribute("data-bump");
        void dockTotal.offsetWidth; // restart the animation
        dockTotal.setAttribute("data-bump", "");
      }
      dockSub.textContent = sub?.textContent?.trim() ?? "";
    };
    mirror();
    const watch = new MutationObserver(mirror);
    watch.observe(total, { childList: true, characterData: true, subtree: true });
    if (sub) watch.observe(sub, { childList: true, characterData: true, subtree: true });

    // Slide in on the first scroll down or the first change/typing in the calculator.
    const engage = () => {
      if (engaged) return;
      engaged = true;
      render();
    };
    form.addEventListener("input", engage);
    form.addEventListener("change", engage);
    // Focus anywhere in the form (keyboard, screen reader, tap) shows the price too.
    form.addEventListener("focusin", () => {
      focusWithin = true;
      engage();
      render();
    });
    form.addEventListener("focusout", (event) => {
      focusWithin = form.contains(event.relatedTarget as Node | null);
      render();
    });
    const onScroll = () => {
      if (window.scrollY - startY > 40) {
        window.removeEventListener("scroll", onScroll);
        engage();
      } else if (window.scrollY < startY) {
        startY = window.scrollY;
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });

    // On screen only while the form is; hidden when the real summary is visible.
    new IntersectionObserver(([entry]) => {
      formVisible = entry.isIntersecting;
      render();
    }).observe(form);
    new IntersectionObserver(
      ([entry]) => {
        // isIntersecting stays true below the threshold, so compare the ratio.
        summaryVisible = entry.intersectionRatio >= 0.35;
        render();
      },
      { threshold: [0, 0.35] },
    ).observe(summary);

    // Ride above the on-screen keyboard (iOS keeps fixed elements behind it).
    const vv = window.visualViewport;
    if (vv) {
      const follow = () => {
        const gap = Math.max(0, window.innerHeight - vv.height - vv.offsetTop);
        dock.style.setProperty("--dock-kb", `${Math.round(gap)}px`);
      };
      vv.addEventListener("resize", follow);
      vv.addEventListener("scroll", follow);
    }
  }
</script>
