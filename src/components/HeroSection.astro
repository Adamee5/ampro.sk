---
/**
 * Hero "Výkres naplno" (docs/creative/brief.md): the first screen is one
 * drawing sheet – a framed sheet with grid coordinates on its edges (A–F,
 * 1–4) like a real construction drawing, the business card's golden-split
 * axis, the title set like the sheet's heading, a large self-drawing house
 * section, and a small title block in the corner. LCP is the h1 (text).
 */
import Icon from "@/components/ui/Icon.astro";
import HeroDrawing from "@/components/creative/HeroDrawing.astro";
import { site, sheetFor } from "@/data/site";
import { withBase } from "@/lib/navigation";
import Button from "./ui/Button.astro";

const hero = site.home.hero;
const sheet = sheetFor("/");
const columns = ["A", "B", "C", "D", "E", "F"];
const rows = ["1", "2", "3", "4"];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="sheet mx-auto max-w-7xl">
    <!-- grid coordinates on the frame (decoration) -->
    <ol class="coords coords--top" aria-hidden="true">{columns.map((c) => <li>{c}</li>)}</ol>
    <ol class="coords coords--left" aria-hidden="true">{rows.map((r) => <li>{r}</li>)}</ol>

    <div class="sheet__inner">
      <div class="sheet__text">
        <p class="hero__eyebrow">{hero.eyebrow}</p>
        <h1 id="hero-title" class="hero__title">{hero.title}</h1>
        {hero.text && <p class="hero__lead">{hero.text}</p>}
        <div class="hero__actions">
          <Button as="a" href={withBase(hero.primaryCta.href)} variant="primary" size="lg" fullWidth rel={undefined}>
            {hero.primaryCta.label}
            <Icon name="arrow-right" class="h-5 w-5" />
          </Button>
          <Button as="a" href={withBase(hero.secondaryCta.href)} variant="outline" size="lg" fullWidth rel={undefined}>
            {hero.secondaryCta.label}
          </Button>
        </div>
      </div>

      <div class="sheet__axis" aria-hidden="true"><span class="sheet__node"></span></div>

      <div class="sheet__drawing">
        <HeroDrawing />
      </div>

      <!-- small title block: the promises as a parts list (Sutnar) -->
      <dl class="stamp tabular">
        <div class="stamp__cell stamp__cell--wide"><dt>Výkres</dt><dd>{sheet.number} · rez domu</dd></div>
        <div class="stamp__cell"><dt>Oprávnenie</dt><dd class="text-energy">{site.credentials.oso}</dd></div>
        <div class="stamp__cell"><dt>Presnosť ceny</dt><dd>±{site.pricing.accuracy} %</dd></div>
        <div class="stamp__cell"><dt>Odpoveď</dt><dd>do 24 h</dd></div>
        <div class="stamp__cell"><dt>Cieľ</dt><dd class="text-energy">A0</dd></div>
      </dl>
    </div>
  </div>
</section>

<style>
  .hero {
    --frame: 1.75rem;
    position: relative;
    padding: clamp(0.75rem, 2vw, 1.5rem) clamp(0.5rem, 2vw, 2rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  /* The sheet: outer trim line + inner frame, coordinates in the margin. */
  .sheet {
    position: relative;
    padding: var(--frame);
    border: 1px solid var(--color-border-strong);
    background: color-mix(in oklch, var(--color-background) 88%, var(--color-surface-elevated));
  }

  .sheet__inner {
    position: relative;
    display: grid;
    gap: 2.5rem;
    padding: clamp(1.5rem, 4vw, 3.5rem) clamp(1rem, 3vw, 3rem) 0;
    border: 2px solid var(--color-line);
    min-height: min(46rem, calc(100svh - var(--header-height) - 4rem));
  }

  @media (min-width: 64rem) {
    .sheet__inner {
      grid-template-columns: 50fr 2px 50fr;
      grid-template-rows: 1fr auto;
      column-gap: 0;
      align-items: center;
      padding-bottom: 0;
    }

    .sheet__text {
      padding-inline-end: clamp(2rem, 3.5vw, 3.5rem);
    }

    .sheet__drawing {
      grid-column: 3;
      grid-row: 1 / span 2;
      align-self: center;
      padding-inline-start: clamp(1rem, 2vw, 2rem);
    }

    .stamp {
      grid-column: 1;
      grid-row: 2;
    }
  }

  @media (min-width: 80rem) {
    .sheet__inner {
      grid-template-columns: 45fr 2px 55fr;
    }
  }

  .coords {
    position: absolute;
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }

  .coords li {
    display: grid;
    place-items: center;
    flex: 1;
  }

  .coords--top {
    inset: 0 var(--frame) auto;
    height: var(--frame);
  }

  .coords--top li + li {
    border-left: 1px solid var(--color-border-strong);
  }

  .coords--left {
    inset: var(--frame) auto var(--frame) 0;
    flex-direction: column;
    width: var(--frame);
  }

  .coords--left li + li {
    border-top: 1px solid var(--color-border-strong);
  }

  .hero__eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .hero__title {
    margin: 1rem 0 0;
    max-width: 14ch;
    font-size: clamp(2.375rem, 1.1rem + 4.6vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
    color: var(--color-foreground);
  }

  .hero__lead {
    margin: 1.5rem 0 0;
    max-width: 52ch;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.125rem);
    line-height: 1.7;
    text-wrap: pretty;
    color: var(--color-muted);
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  @media (min-width: 40rem) {
    .hero__actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  .sheet__drawing {
    width: 100%;
    max-width: 44rem;
    justify-self: center;
  }

  /* Corner title block, drawn like the real one: ruled cells. */
  .stamp {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0 calc(-1 * clamp(1rem, 3vw, 3rem)) 0;
    border-top: 2px solid var(--color-line);
  }

  @media (min-width: 40rem) {
    .stamp {
      grid-template-columns: 1.4fr repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .stamp {
      margin-inline: calc(-1 * clamp(1rem, 3vw, 3rem)) 0;
      margin-top: 2.5rem;
      border-right: 2px solid var(--color-line);
    }
  }

  .stamp__cell {
    padding: 0.625rem 0.875rem;
    border-right: 1px solid var(--color-border-strong);
    border-bottom: 1px solid var(--color-border-strong);
  }

  .stamp__cell--wide {
    grid-column: 1 / -1;
  }

  @media (min-width: 40rem) {
    .stamp__cell {
      border-bottom: 0;
    }

    .stamp__cell--wide {
      grid-column: auto;
    }

    .stamp__cell:last-child {
      border-right: 0;
    }
  }

  .stamp dt {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .stamp dd {
    margin: 0.2rem 0 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-foreground);
  }

  .stamp dd.text-energy {
    color: var(--color-energy);
  }

  /* The card's axes inside the sheet: blue dashed vertical on the split, green
     dashed horizontal across the whole sheet, one node where they cross. */
  .sheet__axis {
    display: none;
  }

  @media (min-width: 64rem) {
    .sheet__axis {
      display: block;
      position: relative;
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: stretch;
      margin-top: calc(-1 * clamp(1.5rem, 4vw, 3.5rem));
      background: repeating-linear-gradient(
          to bottom,
          var(--color-primary) 0 14px,
          transparent 14px 20px,
          var(--color-primary) 20px 23px,
          transparent 23px 29px
        )
        center / 1.5px 100% no-repeat;
    }

    .sheet__axis::after {
      content: "";
      position: absolute;
      top: 72%;
      left: -100vw;
      width: 200vw;
      height: 1.5px;
      background: repeating-linear-gradient(
        to right,
        var(--color-energy) 0 14px,
        transparent 14px 20px,
        var(--color-energy) 20px 23px,
        transparent 23px 29px
      );
    }

    .sheet__node {
      position: absolute;
      top: 72%;
      left: 50%;
      z-index: 1;
      width: 0.875rem;
      aspect-ratio: 1;
      background: var(--color-foreground);
      translate: -50% -50%;
    }
  }

  .sheet {
    overflow: clip;
  }

  @media (forced-colors: active) {
    .sheet__axis,
    .sheet__axis::after {
      background: CanvasText;
    }
  }

  /* Coordinates, title block and axis settle in after the drawing starts;
     text is never animated (readable from the first frame, LCP).*/
  @media (prefers-reduced-motion: no-preference) {
    .coords,
    .stamp,
    .sheet__axis {
      animation: settle var(--duration-label) var(--ease-settle) 600ms both;
    }
  }

  @keyframes settle {
    from {
      opacity: 0;
    }
  }
</style>
