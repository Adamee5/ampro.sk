---
import { site, telHref } from "@/data/site";
import { withBase } from "@/lib/navigation";
import SocialLinks from "./SocialLinks.astro";

const hasSocial = Object.values(site.social).some(Boolean);
---

<!-- Always dark: use text-accent (light tint) here, not text-primary. -->
<footer
  class="border-t border-white/10 bg-footer-bg py-10 text-footer-text sm:py-12"
  aria-labelledby="site-footer-heading"
>
  <h2 id="site-footer-heading" class="sr-only">Päta stránky</h2>
  <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:grid-cols-2 sm:px-6 md:grid-cols-[1.2fr_1fr_1fr] md:items-start lg:px-8">
    <div class="space-y-2 sm:col-span-2 md:col-span-1">
      <p class="text-2xl font-light tracking-tight text-white"><strong class="font-bold">AM</strong>pro.SK</p>
      <p class="text-sm uppercase tracking-wide"><span class="text-accent">Projekcia</span> · <span class="text-energy-accent">Energetika budov</span></p>
      <p class="text-sm leading-6">{site.credentials.osoText}, <span class="text-white">{site.credentials.oso}</span></p>
    </div>

    <div class="space-y-1">
      <p class="text-xs uppercase tracking-eyebrow text-footer-text/70">Kontakt</p>
      {site.company.contacts.map((person) => (
        <>
          <a href={telHref(person.phone)} class="flex min-h-6 items-center py-1 text-sm text-white hover:underline">{person.phone}</a>
          <a href={`mailto:${person.email}`} class="flex min-h-6 items-center py-1 text-sm text-white hover:underline">{person.email}</a>
        </>
      ))}
      <p class="pt-2 text-sm leading-6">{site.company.address}</p>
      <a
        href={withBase("/kontakt/")}
        class="inline-flex min-h-6 items-center py-1 text-sm text-accent hover:underline"
        aria-label="Prejsť na kontaktnú stránku"
      >
        Kontakt &rarr;
      </a>
    </div>

    {
      hasSocial && (
        <div class="space-y-3 md:text-right">
          <p class="text-xs uppercase tracking-eyebrow text-footer-text/70">Sledujte nás</p>
          <SocialLinks
            variant="card"
            align="left"
            class="md:justify-end [&_a]:border-white/20 [&_a]:text-white [&_a:hover]:border-primary [&_a:focus-visible]:border-primary"
          />
        </div>
      )
    }
  </div>

  <div class="mx-auto mt-8 grid max-w-7xl gap-3 border-t border-white/10 px-4 pt-6 text-xs sm:mt-10 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-6 sm:px-6 lg:px-8">
    <p class="leading-6">
      <span class="block sm:inline">Prevádzkovateľ: <span class="text-white">{site.company.legalName}</span></span>
      {
        site.company.ico && (
          <>
            <span class="hidden sm:inline"> · </span>
            <span class="block sm:inline">IČO: <span class="text-white">{site.company.ico}</span></span>
          </>
        )
      }
    </p>
    <p class="leading-6 sm:text-right">
      <span class="block">© {new Date().getFullYear()} {site.name}. Všetky práva vyhradené.</span>
      {
        site.gtmId && (
          <span class="block">
            <button
              type="button"
              data-consent-open
              class="inline-flex min-h-6 cursor-pointer items-center text-white underline decoration-white/30 underline-offset-4 transition-colors duration-fast hover:decoration-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              Nastavenia cookies
            </button>
          </span>
        )
      }
      <span class="block">
        Created by{" "}<a href="https://lukaschylik.dev/" class="text-white underline decoration-white/30 underline-offset-4 transition-colors duration-fast hover:decoration-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">Lukáš Chylík</a>
      </span>
    </p>
  </div>
</footer>
