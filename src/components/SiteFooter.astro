---
/**
 * Footer as the drawing's title block (rohová pečiatka) – docs/creative/brief.md,
 * rule 3 inverted: authority is a stamp with a number, not "X rokov skúseností".
 * A real <dl> table, readable as text; the frame is CSS.
 */
import { site, sheetFor, telHref } from "@/data/site";
import { withBase } from "@/lib/navigation";
import SocialLinks from "./SocialLinks.astro";

const sheet = sheetFor(Astro.url.pathname);
const person = site.company.contacts[0];
const hasSocial = Object.values(site.social).some(Boolean);
const date = new Date().toLocaleDateString("sk-SK", { month: "2-digit", year: "numeric" }).replace(/\s/g, "");
---

<footer class="footer" aria-labelledby="site-footer-heading">
  <h2 id="site-footer-heading" class="sr-only">Päta stránky – údaje o firme</h2>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <div class="block">
      <div class="block__brand">
        <p class="block__wordmark"><strong>AM</strong>pro.SK</p>
        <p class="block__tagline"><span class="text-accent">Projekcia</span> · <span class="text-energy-accent">Energetika budov</span></p>
      </div>

      <dl class="block__cells tabular">
        <div class="cell">
          <dt>Projektant</dt>
          <dd>{person?.name}</dd>
        </div>
        <div class="cell">
          <dt>Oprávnenie</dt>
          <dd class="text-energy-accent">
            <a href={site.credentials.registerUrl} target="_blank" rel="noopener">{site.credentials.oso}<span class="sr-only"> – overiť v registri SKSI (otvorí sa v novom okne)</span></a>
          </dd>
        </div>
        <div class="cell">
          <dt>Kontakt</dt>
          <dd>
            {person && <a href={telHref(person.phone)}>{person.phone}</a>}
            {person && <a href={`mailto:${person.email}`}>{person.email}</a>}
          </dd>
        </div>
        <div class="cell">
          <dt>Sídlo</dt>
          <dd>{site.company.address}</dd>
        </div>
        <div class="cell">
          <dt>Firma</dt>
          <dd>{site.company.legalName} · IČO {site.company.ico}</dd>
        </div>
        <div class="cell cell--sheet">
          <dt>Výkres</dt>
          <dd>{sheet.number} · {sheet.title}</dd>
        </div>
        <div class="cell">
          <dt>Mierka · dátum</dt>
          <dd>1:100 · {date}</dd>
        </div>
        <div class="cell">
          <dt>Odpoveď</dt>
          <dd><a href={withBase("/kontakt/#dopyt")}>do 24 h →</a></dd>
        </div>
      </dl>
    </div>

    <div class="mt-6 flex flex-col gap-4 text-xs sm:flex-row sm:items-center sm:justify-between">
      <p class="leading-6">© {new Date().getFullYear()} {site.company.legalName}. Všetky práva vyhradené.</p>
      {hasSocial && <SocialLinks variant="card" align="left" class="[&_a]:border-white/20 [&_a]:text-white" />}
      <p class="leading-6">
        Created by{" "}<a href="https://lukaschylik.dev/" class="text-white underline decoration-white/30 underline-offset-4 hover:decoration-white">Lukáš Chylík</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-footer-bg);
    color: var(--color-footer-text);
  }

  .block {
    display: grid;
    border: 1.5px solid oklch(1 0 0 / 0.55);
  }

  @media (min-width: 64rem) {
    .block {
      grid-template-columns: 0.9fr 2.1fr;
    }
  }

  .block__brand {
    display: grid;
    align-content: center;
    gap: 0.5rem;
    padding: 1.5rem;
    border-bottom: 1px solid oklch(1 0 0 / 0.25);
  }

  @media (min-width: 64rem) {
    .block__brand {
      border-bottom: 0;
      border-right: 1px solid oklch(1 0 0 / 0.25);
    }
  }

  .block__wordmark {
    margin: 0;
    font-size: 2rem;
    font-weight: 300;
    letter-spacing: -0.035em;
    line-height: 1;
    color: oklch(0.98 0 0);
  }

  .block__wordmark strong {
    font-weight: 700;
  }

  .block__tagline {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .block__cells {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    margin: 0;
  }

  .cell {
    padding: 0.875rem 1rem;
    border-right: 1px solid oklch(1 0 0 / 0.18);
    border-bottom: 1px solid oklch(1 0 0 / 0.18);
  }

  .cell dt {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: oklch(0.8 0 0 / 0.85);
  }

  .cell dd {
    display: grid;
    margin: 0.3rem 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: oklch(0.97 0 0);
  }

  .cell a {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: oklch(1 0 0 / 0.3);
    text-underline-offset: 3px;
    word-break: break-word;
  }

  .cell a:hover {
    text-decoration-color: currentColor;
  }

  .cell--sheet dd {
    font-weight: 600;
  }

  .cell :global(.text-energy-accent) a {
    color: var(--color-energy-accent);
  }
</style>
