---
/**
 * AMpro's own thematic icons, drawn like the rest of the site: 24 × 24,
 * 1.5 px pen, round caps, currentColor – the same grammar as Heroicons
 * outline, so both sets sit together. Names prefixed "am-" are ours; any
 * other name falls back to Heroicons (<Icon>).
 *
 *   <DrawIcon name="am-obalka" class="h-6 w-6" />
 *   <DrawIcon name="phone" class="h-6 w-6" />
 */
import Icon from "@/components/ui/Icon.astro";

export interface Props {
  name: string;
  class?: string;
  label?: string;
}

const { name, class: className = "h-6 w-6", label } = Astro.props;

/** Paths in a 24 × 24 box. Secondary strokes get class "a" (55 % opacity). */
const ICONS: Record<string, string> = {
  // house: saddle roof, walls, door
  "am-dom": `<path d="M3 11.25 12 3.75l9 7.5"/><path d="M5.25 9.5V20.25h13.5V9.5"/><path d="M10 20.25v-5h4v5"/>`,
  // house section with the thermal envelope hatched (energy)
  "am-obalka": `<path d="M2.75 11.5 12 3.5l9.25 8"/><path d="M4.75 9.75v10.5h14.5V9.75"/><path class="a" d="M7.25 18.25V11.4L12 7.1l4.75 4.3v6.85z"/><path class="a" d="m5 13.5 2-2M5 17l2-2M17 13.5l2-2M17 17l2-2"/>`,
  // energy performance label: bars getting shorter, the top one marked
  "am-stitok": `<path d="M4 5.25h5.5l1.25 1.5-1.25 1.5H4z"/><path class="a" d="M4 11.25h8.5M4 15.25h11.5M4 19.25h14.5"/><path d="M14.5 6.75h5.5"/>`,
  // dimension line with 45° ticks
  "am-kota": `<path d="M3.5 12h17"/><path d="M3.5 7.5v9M20.5 7.5v9"/><path d="m2 13.5 3-3M19 13.5l3-3"/><path class="a" d="M8.5 9.5h7"/>`,
  // BIM model: isometric cube with the grid
  "am-bim": `<path d="m12 2.75 8.25 4.6v9.3L12 21.25l-8.25-4.6v-9.3z"/><path d="M12 12 20.25 7.35M12 12v9.25M12 12 3.75 7.35"/><path class="a" d="m7.9 9.7v9.2M16.1 9.7v9.2"/>`,
  // building plot: trapezoid with survey stakes
  "am-pozemok": `<path d="M2.75 19.25 6.5 9.5h11l3.75 9.75z"/><path d="M6.5 9.5V4.75M17.5 9.5V4.75"/><path d="M6.5 4.75 9 6 6.5 7.25M17.5 4.75 20 6l-2.5 1.25"/><path class="a" d="M8 14.5h8"/>`,
  // drafting compass – "where do I start"
  "am-kruzidlo": `<circle cx="12" cy="4.75" r="1.75"/><path d="M11.1 6.3 6 20.25M12.9 6.3 18 20.25"/><path class="a" d="M7.75 15.25h8.5"/><path d="M12 3V1.75"/>`,
  // calculator with the price line
  "am-kalkulacka": `<rect x="5.25" y="2.75" width="13.5" height="18.5" rx="1.5"/><path d="M8.25 6.25h7.5v3h-7.5z"/><path class="a" d="M8.5 13h.01M12 13h.01M15.5 13h.01M8.5 16.5h.01M12 16.5h.01M15.5 16.5h.01"/>`,
  // utility connection: pipe from the street into the house
  "am-pripojka": `<path d="M11 10.5 16.5 6l5 4.5"/><path d="M12.75 9v9.25h7.5V9"/><path d="M2.5 15.25h8"/><path class="a" d="M2.5 18.25h8"/><path d="M10.5 13.75v6"/>`,
  // CNC / cutting plan: board with cut lines and a saw tooth
  "am-narez": `<rect x="3" y="5.25" width="18" height="13.5" rx="1"/><path class="a" d="M9 5.25v13.5M3 12h6M15 5.25v7.5h6"/><path d="m15 12.75 1.5 1.5 1.5-1.5 1.5 1.5"/>`,
};

const custom = ICONS[name];
---

{
  custom ? (
    <svg
      class:list={["draw-icon", className]}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      focusable="false"
      role={label ? "img" : undefined}
      aria-label={label}
      aria-hidden={label ? undefined : "true"}
      set:html={custom}
    />
  ) : (
    <Icon name={name} class={className} label={label} />
  )
}

<style>
  .draw-icon :global(.a) {
    opacity: 0.55;
  }
</style>
