---
/**
 * The guide → price → inquiry path, shown above /sprievodca/ and
 * /konfigurator/ so the visitor always knows where they are. Drawn as a chain
 * dimension (each step a measured segment). Done steps link back, the next
 * step is a link forward, the current one has aria-current="step".
 */
import { withBase } from "@/lib/navigation";
import DrawIcon from "@/components/creative/DrawIcon.astro";

export interface Props {
  current: 1 | 2 | 3;
}

const { current } = Astro.props;
const steps = [
  { title: "Sprievodca", text: "5 otázok o vašom zámere", href: "/sprievodca/", icon: "am-kruzidlo" },
  { title: "Orientačná cena", text: "predvyplnená podľa odpovedí", href: "/konfigurator/", icon: "am-kalkulacka" },
  { title: "Dopyt", text: "pošlete výber a podklady", href: "/konfigurator/#dopyt", icon: "paper-airplane" },
];
---

<nav class="flow" aria-label="Postup k cenovej ponuke">
  <ol class="flow__list">
    {
      steps.map((step, index) => {
        const number = index + 1;
        const state = number < current ? "done" : number === current ? "current" : "next";
        const content = (
          <>
            <span class="flow__icon" aria-hidden="true"><DrawIcon name={state === "done" ? "check" : step.icon} class="h-5 w-5" /></span>
            <span class="flow__title">
              {step.title}
              {state === "done" && <span class="sr-only"> (hotovo)</span>}
            </span>
            <span class="flow__text">{step.text}</span>
          </>
        );
        return (
          <li class:list={["flow__step", `flow__step--${state}`]}>
            {state === "current" ? (
              <span class="flow__body" aria-current="step">{content}</span>
            ) : (
              <a class="flow__body" href={withBase(step.href)} data-flow-link={number}>{content}</a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  /* Sticky under the header, semi-transparent paper with a blur behind
     (blur on ::before, like the template's .glass, so the bar never becomes
     a containing block for fixed descendants). */
  .flow {
    position: sticky;
    top: var(--header-height);
    z-index: var(--z-sticky);
    margin-inline: calc(-1 * var(--grid-pad, 1rem));
    padding: 1.25rem var(--grid-pad, 1rem) 0.25rem;
    isolation: isolate;
    background: color-mix(in oklab, var(--color-background) 72%, transparent);
    border-bottom: 1px solid var(--color-border);
  }

  .flow::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    pointer-events: none;
  }

  /* Anchors (#dopyt) and other sticky elements clear the bar too. */
  :global(html:has(.flow)) {
    --flow-height: 9rem;
    scroll-padding-block-start: calc(var(--header-height) + var(--flow-height) + 1rem);
  }

  @media (max-width: 30rem) {
    :global(html:has(.flow)) {
      --flow-height: 7rem;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .flow {
      background: var(--color-background);
    }
  }

  .flow__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .flow__step {
    --tone: var(--color-border-strong);
    position: relative;
    border-top: 2px solid var(--tone);
  }

  .flow__step--done,
  .flow__step--current {
    --tone: var(--color-primary);
  }

  .flow__step:last-child.flow__step--current {
    --tone: var(--color-energy);
  }

  /* 45° ticks at each segment boundary, like a chain dimension */
  .flow__step::before,
  .flow__step:last-child::after {
    content: "";
    position: absolute;
    top: -0.6rem;
    left: -1px;
    width: 1.5px;
    height: 1.1rem;
    background: var(--tone);
    rotate: 45deg;
  }

  .flow__step:last-child::after {
    left: auto;
    right: -1px;
  }

  .flow__body {
    display: grid;
    justify-items: start;
    gap: 0.15rem;
    min-height: 2.75rem;
    padding: 0.875rem 1rem 0.5rem 0;
    color: inherit;
    text-decoration: none;
  }

  a.flow__body:hover .flow__title,
  a.flow__body:focus-visible .flow__title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .flow__icon {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    aspect-ratio: 1;
    margin-bottom: 0.25rem;
    border: 1.5px solid var(--tone);
    border-radius: 50%;
    background: var(--color-background);
    color: var(--tone);
  }

  .flow__step--current .flow__icon {
    background: var(--tone);
    color: var(--color-background);
  }

  .flow__step--next .flow__icon {
    color: var(--color-muted);
  }

  .flow__title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-foreground);
  }

  .flow__step--next .flow__title {
    color: var(--color-muted);
  }

  .flow__text {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-muted);
  }


  @media (max-width: 30rem) {
    .flow__text {
      display: none;
    }
  }
</style>

<script>
  // On the configurator the "Sprievodca" link keeps the visitor's answers out
  // of the way (plain link), and the "Dopyt" step keeps the prefilled query.
  const query = location.search;
  if (query) {
    document.querySelectorAll<HTMLAnchorElement>('[data-flow-link="3"]').forEach((link) => {
      link.href = `${location.pathname}${query}#dopyt`;
    });
  }
</script>
